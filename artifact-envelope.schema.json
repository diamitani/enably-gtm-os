{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ROSTRv2 Artifact Envelope",
  "type": "object",
  "required": [
    "artifact_id",
    "artifact_type",
    "workspace_id",
    "status",
    "version",
    "created_at",
    "provenance",
    "payload"
  ],
  "properties": {
    "artifact_id": {
      "type": "string"
    },
    "artifact_type": {
      "type": "string"
    },
    "workspace_id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "draft",
        "approved",
        "rejected",
        "archived"
      ]
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner_agent": {
      "type": "string"
    },
    "approval": {
      "type": "object",
      "properties": {
        "required": {
          "type": "boolean"
        },
        "state": {
          "enum": [
            "not_required",
            "pending",
            "approved",
            "rejected"
          ]
        },
        "approved_by": {
          "type": "string"
        },
        "approved_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "provenance": {
      "type": "object",
      "required": [
        "input_refs",
        "agent_id"
      ],
      "properties": {
        "input_refs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "agent_id": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "prompt_version": {
          "type": "string"
        },
        "source_urls": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "payload": {
      "type": "object"
    }
  }
}